{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "packageManager": "npm", "analytics": false },
  "newProjectRoot": "projects",
  "projects": {
    "angular22-strict-template-checks-demo": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json"
          },
          "configurations": {
            "production": { "outputHashing": "all", "outputPath": "dist/production" },
            "development": { "optimization": false, "extractLicenses": false, "sourceMap": true, "outputPath": "dist/development" },
            "strict": { "tsConfig": "tsconfig.strict.json", "outputPath": "dist/strict" }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": { "buildTarget": "angular22-strict-template-checks-demo:build:development" }
        }
      }
    }
  }
}
